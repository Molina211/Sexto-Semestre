pipeline {
    agent any

    triggers {
        cron('H 10 * * *')
    }

    environment {
        GIT_URL = 'https://github.com/Molina211/Sexto-Semestre.git'
    }

    stages {
        stage('Clonar repositorio') {
            steps {
                echo '📦 Clonando el repositorio...'
                git branch: 'main', url: env.GIT_URL
            }
        }

        stage('Backup de apuntes') {
            steps {
                script {
                    def date = sh(script: "date +%Y-%m-%d_%H-%M-%S", returnStdout: true).trim()
                    def backupDir = "/var/jenkins_home/backups_apuntes/${date}"
                    sh """
                        mkdir -p ${backupDir}
                        cp -r * ${backupDir}/
                        echo '✅ Backup completado en ${backupDir}' > backup_log.txt
                    """
                    echo "✅ Backup completado en: ${backupDir}"
                }
            }
        }

        stage('Notificar por correo') {
            steps {
                script {
                    // 🚀 Detectar si viene de GitHub (push) o del cron
                    def triggeredBy = currentBuild.getBuildCauses().collect { it.shortDescription }.join(', ')
                    def esPush = triggeredBy.contains("SCMTrigger") || triggeredBy.contains("GitHub")

                    def fecha = new Date().format("yyyy-MM-dd HH:mm:ss")
                    def estado = currentBuild.currentResult
                    def colorEstado = estado == 'SUCCESS' ? '#4CAF50' : '#E74C3C'

                    def asunto, mensaje

                    if (esPush) {
                        asunto = "🚀 Actualización detectada - ${env.JOB_NAME}"
                        mensaje = """
                            <html><body>
                            <h2 style="color:#2980b9;">🚀 Nueva actualización detectada</h2>
                            <p><b>Fecha:</b> ${fecha}</p>
                            <p><b>Repositorio:</b> ${env.GIT_URL}</p>
                            <p><b>Estado:</b> <span style="color:${colorEstado}; font-weight:bold;">${estado}</span></p>
                            <p>Cambios recientes fueron detectados y respaldados automáticamente.</p>
                            <hr><p style="font-size:12px;">Notificación automática de Jenkins</p>
                            </body></html>
                        """
                    } else {
                        asunto = "📚 Informe diario - ${env.JOB_NAME}"
                        mensaje = """
                            <html><body>
                            <h2 style="color:#34495e;">📘 Informe diario de apuntes</h2>
                            <p><b>Fecha:</b> ${fecha}</p>
                            <p><b>Tarea:</b> ${env.JOB_NAME}</p>
                            <p><b>Repositorio:</b> ${env.GIT_URL}</p>
                            <p><b>Duración:</b> ${currentBuild.durationString}</p>
                            <p style="color:${colorEstado};"><b>Estado:</b> ${estado}</p>
                            <hr><p style="font-size:12px;">Informe automático programado de Jenkins</p>
                            </body></html>
                        """
                    }

                    emailext(
                        subject: asunto,
                        body: mensaje,
                        mimeType: 'text/html',
                        to: 'jhonmolina21109@gmail.com'
                    )
                }
            }
        }
    }
}
